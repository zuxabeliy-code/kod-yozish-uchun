# === Telegram (https://my.telegram.org -> API development tools) ===
API_ID=
API_HASH=
# Userbot akkaunt session fayli (login.py yaratadi)
SESSION_PATH=data/jarvis

# === Egasi (Zuxa'ning Telegram user id'si; @userinfobot orqali bilib oling) ===
OWNER_ID=
# Qo'shimcha ruxsat berilganlar (vergul bilan), ixtiyoriy
ALLOWED_IDS=

# === AI (miya) ===
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
MAX_TOKENS_TEXT=800
MAX_TOKENS_VOICE=250
HISTORY_LIMIT=20
SYSTEM_PROMPT_PATH=prompts/system.md

# === STT: faster_whisper (lokal) yoki openai (OpenAI-mos API) ===
STT_PROVIDER=faster_whisper
STT_LANGUAGE=uz
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# STT_PROVIDER=openai bo'lsa:
STT_API_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_API_MODEL=whisper-1

# === TTS (edge-tts) ===
TTS_PROVIDER=edge
# uz | ru | en
TTS_LANG=uz
TTS_VOICE_UZ=uz-UZ-MadinaNeural
TTS_VOICE_RU=ru-RU-SvetlanaNeural
TTS_VOICE_EN=en-US-GuyNeural
TTS_RATE=+0%

# === Qo'ng'iroq (xavfli modul; ishlamasa false qiling, matn/ovoz baribir ishlaydi) ===
CALLS_ENABLED=true
VAD_AGGRESSIVENESS=2
VAD_SILENCE_MS=700
CALL_GREETING=Salom Zuxa, eshitaman.

# === Xavfsizlik / flood himoya ===
RATE_LIMIT_PER_MIN=20
REPLY_DELAY_MIN=0.8
REPLY_DELAY_MAX=2.0
MAX_VOICE_SECONDS=120

# === Boshqa ===
DB_PATH=data/jarvis.db
LOG_LEVEL=INFO
