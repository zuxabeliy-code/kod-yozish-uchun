<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Orqaga"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.25"
            android:text="@string/settings_title"
            android:textColor="@color/jv_cyan"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="32dp">

            <TextView style="@style/Jarvis.Section" android:text="SERVER" />

            <TextView style="@style/Jarvis.Label" android:text="@string/server_url" />
            <EditText
                android:id="@+id/etUrl"
                style="@style/Jarvis.Input"
                android:hint="@string/server_url_hint"
                android:importantForAutofill="no"
                android:inputType="textUri" />

            <TextView style="@style/Jarvis.Label" android:text="@string/device_token" />
            <EditText
                android:id="@+id/etToken"
                style="@style/Jarvis.Input"
                android:fontFamily="monospace"
                android:hint="@string/device_token_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvTokenState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/jv_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnTest"
                style="@style/Jarvis.Button"
                android:text="@string/btn_test" />

            <TextView style="@style/Jarvis.Section" android:text="@string/stt_title" />
            <RadioGroup
                android:id="@+id/rgStt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <RadioButton android:id="@+id/sttAuto" style="@style/Jarvis.Radio" android:text="@string/stt_auto" />
                <RadioButton android:id="@+id/sttAndroid" style="@style/Jarvis.Radio" android:text="@string/stt_android" />
                <RadioButton android:id="@+id/sttServer" style="@style/Jarvis.Radio" android:text="@string/stt_server" />
            </RadioGroup>

            <TextView style="@style/Jarvis.Section" android:text="@string/tts_title" />
            <RadioGroup
                android:id="@+id/rgTts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <RadioButton android:id="@+id/ttsAuto" style="@style/Jarvis.Radio" android:text="@string/tts_auto" />
                <RadioButton android:id="@+id/ttsAndroid" style="@style/Jarvis.Radio" android:text="@string/tts_android" />
                <RadioButton android:id="@+id/ttsServer" style="@style/Jarvis.Radio" android:text="@string/tts_server" />
            </RadioGroup>

            <TextView
                android:id="@+id/tvRate"
                style="@style/Jarvis.Label"
                android:text="@string/tts_rate" />
            <SeekBar
                android:id="@+id/sbRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="15"
                android:progressTint="@color/jv_cyan"
                android:thumbTint="@color/jv_cyan" />

            <Button
                android:id="@+id/btnTtsSettings"
                style="@style/Jarvis.Button"
                android:text="@string/btn_tts_settings" />

            <TextView style="@style/Jarvis.Section" android:text="@string/diag_title" />
            <TextView
                android:id="@+id/tvDiag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:padding="12dp"
                android:textColor="@color/jv_text"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnRoot"
                style="@style/Jarvis.Button"
                android:text="@string/btn_root" />

            <Button
                android:id="@+id/btnSave"
                style="@style/Jarvis.Button"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/btn_save"
                android:textColor="#FFE0FBFF"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
